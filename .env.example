# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/thoth?schema=public"

# ============================================
# Application URLs
# ============================================
# Frontend/Application URL (used for redirects, cookies, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend/API URL (used by frontend to call backend APIs)
# Leave empty to use relative /api/* requests
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"

# Marketplace URL (public catalogue of modules/templates for sale).
# Used by the public homepage link and editable in /admin/marketplace (SiteConfig.marketplaceUrl).
NEXT_PUBLIC_MARKETPLACE_URL=""

# ============================================
# Extensions Configuration
# ============================================
# Directory where extensions are stored
EXTENSIONS_DIR="extensions"

# Enable/disable write operations to extensions directory
# Required for both ZIP upload and install-from-URL (filesystem install)
EXTENSIONS_WRITE_ENABLED="false"

# Optional comma-separated allowlist of hosts permitted for install-from-URL.
# Listed hosts bypass the public-https/private-IP guard (use for trusted internal
# artifact servers only). Example: EXTENSIONS_ALLOWED_HOSTS="artifacts.example.com"
EXTENSIONS_ALLOWED_HOSTS=""

# ============================================
# Templates Configuration
# ============================================
# Directory where theme/template packs are stored
TEMPLATES_DIR="templates"

# Enable/disable write operations to templates directory
# Required for both ZIP upload and install-from-URL (filesystem install)
TEMPLATES_WRITE_ENABLED="false"

# Note: install-from-URL for templates reuses EXTENSIONS_ALLOWED_HOSTS
# as its host allowlist for trusted internal artifact servers.

# ============================================
# Media Storage (Optional)
# ============================================
# AWS S3 Configuration
AWS_S3_BUCKET=""
AWS_S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ============================================
# Security & Authentication
# ============================================
# REQUIRED: session cookies are HMAC-signed with this secret.
# Generate: openssl rand -hex 32
SESSION_SECRET="your-secret-key-here-change-in-production"

# CORS allowlist for cross-origin API clients (exact origins, comma-separated).
# No wildcard support on purpose. Leave empty to disable cross-origin access.
# Example: https://app.example.com,http://localhost:5173
ALLOWED_ORIGINS=""

# Bearer secret for POST /api/admin/automation/cron.
# Endpoint fails closed (401 for every request) while unset.
AUTOMATION_CRON_SECRET=""

# REQUIRED for storing API keys (e.g. automation config). 32-byte hex.
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# ============================================
# Email Configuration (Optional)
# ============================================
# SMTP credentials for email notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ============================================
# Third-party Services (Optional)
# ============================================
# AI/ML API Keys
GEMINI_API_KEY=""

# GitHub API (for staff member GitHub integration)
GITHUB_API_TOKEN=""

# ============================================
# Development/Debug
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL="info"

# ============================================
# Build Configuration
# ============================================
# Skip engine checks
SKIP_ENV_VALIDATION="false"
