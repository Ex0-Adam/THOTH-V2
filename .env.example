# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/thoth?schema=public"

# ============================================
# Application URLs
# ============================================
# Frontend/Application URL (used for redirects, cookies, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend/API URL (used by frontend to call backend APIs)
# Leave empty to use relative /api/* requests
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"

# ============================================
# Extensions Configuration
# ============================================
# Directory where extensions are stored
EXTENSIONS_DIR="extensions"

# Enable/disable write operations to extensions directory
EXTENSIONS_WRITE_ENABLED="false"

# ============================================
# Media Storage (Optional)
# ============================================
# AWS S3 Configuration
AWS_S3_BUCKET=""
AWS_S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ============================================
# Security & Authentication
# ============================================
# REQUIRED: session cookies are HMAC-signed with this secret.
# Generate: openssl rand -hex 32
SESSION_SECRET="your-secret-key-here-change-in-production"

# CORS allowlist for cross-origin API clients (exact origins, comma-separated).
# No wildcard support on purpose. Leave empty to disable cross-origin access.
# Example: https://app.example.com,http://localhost:5173
ALLOWED_ORIGINS=""

# Bearer secret for POST /api/admin/automation/cron.
# Endpoint fails closed (401 for every request) while unset.
AUTOMATION_CRON_SECRET=""

# REQUIRED for storing API keys (e.g. automation config). 32-byte hex.
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# ============================================
# Email Configuration (Optional)
# ============================================
# SMTP credentials for email notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ============================================
# Third-party Services (Optional)
# ============================================
# AI/ML API Keys
GEMINI_API_KEY=""

# GitHub API (for staff member GitHub integration)
GITHUB_API_TOKEN=""

# ============================================
# Development/Debug
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL="info"

# ============================================
# Build Configuration
# ============================================
# Skip engine checks
SKIP_ENV_VALIDATION="false"
